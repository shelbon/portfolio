---
import { t } from '../../i18n/index.js';

const { locale } = Astro.props;
---

<footer>
  <p>{t(locale, 'footer')}</p>
</footer>

<style>
  footer { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 16rem; background: var(--bg-color-ternary); }
  p { width: 80%; margin-bottom: 1.6rem; color: var(--text-color-light); font-size: 2rem; text-align: center; }
  @media screen and (min-width: 768px) { footer { min-height: 8rem; } }
</style>
